# Required to send proposal forms in production. Configure this as a Cloudflare Worker secret.
RESEND_API_KEY=""

# Optional override of the production GA ID. Analytics requires accepted consent
# and the canonical wyedesign.co.uk host; local/dev/Worker previews never collect.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional: add this when verifying the domain with Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
